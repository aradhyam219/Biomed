{
  "$defs": {
    "EnrichmentPatch": {
      "additionalProperties": false,
      "description": "Additions to a temporary Pass-1 reference; no topology fields allowed.",
      "properties": {
        "relation_ref": {
          "title": "Relation Ref",
          "type": "string"
        },
        "intervention": {
          "items": {
            "$ref": "#/$defs/SupportedValue"
          },
          "title": "Intervention",
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/SupportedValue"
          },
          "title": "Effects",
          "type": "array"
        },
        "context": {
          "items": {
            "$ref": "#/$defs/SupportedValue"
          },
          "title": "Context",
          "type": "array"
        }
      },
      "required": [
        "relation_ref",
        "intervention",
        "effects",
        "context"
      ],
      "title": "EnrichmentPatch",
      "type": "object"
    },
    "StructuredRelation": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Supplied source entity ID",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "description": "Supplied target entity ID",
          "title": "Target",
          "type": "string"
        },
        "predicate": {
          "description": "Concise normalized predicate faithfully describing the asserted relation",
          "title": "Predicate",
          "type": "string"
        },
        "assertion": {
          "description": "Complete source-grounded restatement of the scientific meaning; do not add information absent from the evidence",
          "title": "Assertion",
          "type": "string"
        },
        "evidence": {
          "description": "Verbatim contiguous source-text evidence",
          "title": "Evidence",
          "type": "string"
        },
        "negated": {
          "description": "Whether the asserted relation is explicitly negated",
          "title": "Negated",
          "type": "boolean"
        },
        "intervention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional explicit intervention or perturbation material to the assertion; leave null when not applicable",
          "title": "Intervention"
        },
        "effects": {
          "description": "Optional explicit effects or outcomes; do not infer them and use an empty list when not applicable",
          "items": {
            "type": "string"
          },
          "title": "Effects",
          "type": "array"
        },
        "context": {
          "description": "Optional explicit biological, experimental, clinical, organismal, tissue, cellular, disease-state, cohort, environmental, or comparable setting/condition needed to interpret where or under what conditions the relation holds; do not use for mechanisms, another relation, or another entity interaction",
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "surface_form": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional verbatim relation wording",
          "title": "Surface Form"
        }
      },
      "required": [
        "source",
        "target",
        "predicate",
        "assertion",
        "evidence",
        "negated"
      ],
      "title": "StructuredRelation",
      "type": "object"
    },
    "SupportedValue": {
      "additionalProperties": false,
      "description": "One proposed rich value with independently inspectable local evidence.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "supporting_evidence": {
          "title": "Supporting Evidence",
          "type": "string"
        }
      },
      "required": [
        "value",
        "supporting_evidence"
      ],
      "title": "SupportedValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Experimental proposals separate from RelationExtractionResult.",
  "properties": {
    "missing_relations": {
      "items": {
        "$ref": "#/$defs/StructuredRelation"
      },
      "title": "Missing Relations",
      "type": "array"
    },
    "enrichment_patches": {
      "items": {
        "$ref": "#/$defs/EnrichmentPatch"
      },
      "title": "Enrichment Patches",
      "type": "array"
    }
  },
  "required": [
    "missing_relations",
    "enrichment_patches"
  ],
  "title": "AuditPayload",
  "type": "object"
}
