{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "extractor_version": {
          "type": "string",
          "pattern": "\\S"
        },
        "extraction_profile": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "extraction_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "build_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "minLength": 40,
          "maxLength": 40
        }
      },
      "required": [
        "extractor_version",
        "extraction_profile",
        "source_sha256",
        "extraction_input_sha256",
        "generated_at",
        "build_revision"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "pattern": "\\S"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "mentions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "type": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "text",
                "type",
                "start",
                "end",
                "score"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "paper_role": {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "substantive",
                  "contextual"
                ]
              },
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "minItems": 1,
                "maxItems": 2
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "minItems": 1
              }
            },
            "required": [
              "category",
              "paragraphs",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "aliases",
          "mentions"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "pattern": "\\S"
          },
          "predicate": {
            "type": "string",
            "pattern": "\\S"
          },
          "negated": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "assertion": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "intervention": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 0
                },
                "context": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 0
                },
                "surface_form": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "text",
                "assertion",
                "intervention",
                "effects",
                "context",
                "surface_form",
                "score"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "predicate",
          "negated",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "document",
    "provenance",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
